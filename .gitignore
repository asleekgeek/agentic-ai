# Dependencies
node_modules/
# Build outputs
.pnpm-store/
dist/
build/
*.tsbuildinfo
# Rust build dir (codebase-rust)
target/

# Exceptions: plugin distribution bundles MUST be tracked so end-users get a
# self-contained artifact when they run `claude plugin install <name>`.
# Each plugin's dist/ is built by `pnpm bundle` and committed.
!plugins/*/dist/
!plugins/*/dist/**
!packages/reasoning/dist/
# Worktrees — local-only, never committed
!packages/reasoning/dist/**
# OS / editor
worktrees/
.DS_Store
*.swp
.idea/
.vscode/
# share recommended extensions
!.vscode/extensions.json

# Test artifacts
coverage/
.vitest-cache/
# parity test run outputs (large, regenerated)
parity-oracle/runs/

# Local state
.env
.env.local
# Claude Code session state (per-developer, not shared)
*.local
.claude/session-cache.json
# Logs
.claude/scheduled_tasks.lock
*.log
npm-debug.log*
# Cortex local DB (developer-specific)
pnpm-debug.log*
.cortex.db
.prd-gen/
