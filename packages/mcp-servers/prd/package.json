    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@agentic/prd-benchmark": "workspace:*",
    "@agentic/prd-core": "workspace:*",
    "@agentic/prd-orchestration": "workspace:*",
    "@agentic/prd-strategy": "workspace:*",
    "@agentic/prd-validation": "workspace:*",
    "@agentic/prd-verification": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
