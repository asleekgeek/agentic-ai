{
  "name": "@agentic/mcp-server-codebase",
  "version": "0.1.0",
  "private": true,
  "description": "Full TypeScript port of automatised-pipeline 0.0.9 Rust codebase-intelligence MCP server. 23 tools, PG backend, Louvain community detection, hybrid BM25+TF-IDF search.",
